# Local operator dashboard. Never expose publicly.
# Fixed origin only; no path, credentials, query, or fragment.
BACKEND_ORIGIN=http://127.0.0.1:3000
# Same temporary token as backend; SERVER ONLY. Never use NEXT_PUBLIC_.
MANAGEMENT_API_TOKEN=replace-with-backend-management-token
# Exact dashboard host:port values accepted by the adapter. This is not authentication.
DASHBOARD_ALLOWED_HOSTS=127.0.0.1:3001,localhost:3001
