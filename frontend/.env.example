# Server-only fixed origins; no path, credentials, query, or fragment.
BACKEND_ORIGIN=http://127.0.0.1:3000
DASHBOARD_ORIGIN=http://127.0.0.1:3001
# Explicit localhost HTTP development only. Production: secure + HTTPS origin.
DASHBOARD_COOKIE_MODE=local-http
# Optional ONLY behind an ingress that overwrites this header and prevents direct access.
# DASHBOARD_TRUSTED_CLIENT_IP_HEADER=x-real-ip

# Public runtime URL shown in dashboard; never derived from private BACKEND_ORIGIN.
PUBLIC_RUNTIME_ORIGIN=http://127.0.0.1:3000
