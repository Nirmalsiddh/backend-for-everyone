# Copy OUTSIDE the repository, chmod 600. Use hex passwords to avoid URL escaping.
BACKEND_IMAGE=ghcr.io/REPLACE/platform-backend:v0.3.0-alpha.1
FRONTEND_IMAGE=ghcr.io/REPLACE/platform-frontend:v0.3.0-alpha.1
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=operator@example.com
# Space-separated exact tester IPs/CIDRs. No public-all fallback.
TESTER_CIDRS=REPLACE_WITH_TESTER_IP/32
POSTGRES_BOOTSTRAP_PASSWORD=REPLACE_WITH_RANDOM_HEX
POSTGRES_APP_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
POSTGRES_MIGRATION_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
CONNECTION_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
CUSTOMER_DB_ALLOWED_DESTINATIONS=db.customer.example:5432
RUNTIME_ALLOWED_ORIGINS=https://tester-app.example.com
# Choose non-overlapping private addresses; all three peer addresses must match.
PROXY_SUBNET=172.30.10.0/24
CADDY_IP=172.30.10.2
FRONTEND_IP=172.30.10.3
BACKEND_IP=172.30.10.4
