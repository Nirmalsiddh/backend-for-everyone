NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_RUNTIME_ORIGIN=http://127.0.0.1:3000
PLATFORM_DATABASE_URL=postgresql://platform:password@localhost:5432/platform
# Optional: trust the loopback Next.js proxy for forwarded client IPs.
# Set only when backend access is restricted to that proxy.
# TRUSTED_DASHBOARD_PROXY=127.0.0.1
# Only needed for integration tests; must be a disposable, separate database.
# Optional separate EMPTY disposable database for the alpha upgrade preservation test.
# TEST_LEGACY_DATABASE_URL=postgresql://platform:password@localhost:5432/platform_legacy_test
# TEST_DATABASE_URL=postgresql://platform:password@localhost:5432/platform_test

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key outside the database; losing/changing it makes saved credentials unreadable.
CONNECTION_ENCRYPTION_KEY=replace-with-64-hex-characters
# Integration tests also require a separate customer database with password authentication.
# TEST_CUSTOMER_DATABASE_URL=postgresql://customer:password@localhost:5432/customer_test

# Browser origins permitted to read /api responses; empty disables cross-origin access.
# Use comma-separated exact origins, without trailing slashes or wildcards.
RUNTIME_ALLOWED_ORIGINS=http://localhost:5173

# Local disposable databases only. Production always requires restricted policy.
CUSTOMER_DB_POLICY=development
# Hosted example: exact DNS hostnames + ports, no wildcards or IP literals.
# CUSTOMER_DB_ALLOWED_DESTINATIONS=db.customer.example:5432
# Exact trusted proxy source IPs only; no CIDRs or trust-all.
# TRUSTED_PROXY_IPS=172.30.10.2,172.30.10.3
